TELEGRAM_BOT_TOKEN=токен_от_BotFather
# Proxy is optional. Remove or leave empty to connect directly.
# YTDLP_PROXY=http://proxy.example:8080
# TELEGRAM_PROXY=http://proxy.example:8080
TELEGRAM_CACHE_CHAT_ID=-1001234567890
# File ID фото-заглушки для inline-обработки.
INLINE_PLACEHOLDER_PHOTO_ID=сюда_file_id_фото_заглушки

# Для первого production-варианта используем polling.
BOT_MODE=polling

LOG_LEVEL=INFO
DISK_CACHE_DIR=/data/cache
RAM_CACHE_MAXSIZE=10000
RAM_CACHE_TTL=86400
DISK_CACHE_TTL=2592000

YTDLP_SOCKET_TIMEOUT=30
YTDLP_RETRIES=1
TELEGRAM_REQUEST_TIMEOUT=120
MAX_CONCURRENT_JOBS=2
MAX_FILE_SIZE=52428800
MAX_DURATION=600
TEMP_DIR=/tmp
TEMP_TTL=86400
RATE_LIMIT_USERS=10000
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60
WEBHOOK_MAX_BODY_SIZE=1048576

# Нужно только при переходе на webhook:
# PUBLIC_BASE_URL=https://bot.example.com
# WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=случайная_секретная_строка
# WEB_SERVER_HOST=0.0.0.0
# WEB_SERVER_PORT=8080
