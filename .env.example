TELEGRAM_BOT_TOKEN=токен_от_BotFather
# Proxy is optional. Remove or leave empty to connect directly.
# YTDLP_PROXY=http://proxy.example:8080
# Optional path to a Netscape-format cookies file. Defaults to
# /data/cache/cookies.txt (in the cache volume) — admin can update it
# by sending a file named cookie.txt to the bot.
# YTDLP_COOKIES_FILE=/data/cache/cookies.txt
# TELEGRAM_PROXY=http://proxy.example:8080
TELEGRAM_CACHE_CHAT_ID=-1001234567890

# Chat ID of the admin (owner) for /clear-cache and cookie.txt upload.
# ADMIN_CHAT_ID=123456789

LOG_LEVEL=INFO
DISK_CACHE_DIR=/data/cache
RAM_CACHE_MAXSIZE=10000
RAM_CACHE_TTL=86400
DISK_CACHE_TTL=2592000
INLINE_TIMEOUT=20
YTDLP_SOCKET_TIMEOUT=30
YTDLP_RETRIES=1
TELEGRAM_REQUEST_TIMEOUT=120
MAX_CONCURRENT_JOBS=2
MAX_FILE_SIZE=52428800
MAX_DURATION=600
TEMP_DIR=/tmp
TEMP_TTL=86400
RATE_LIMIT_USERS=10000
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60
PM_TASK_MAXSIZE=10000
PM_TASK_TTL=86400